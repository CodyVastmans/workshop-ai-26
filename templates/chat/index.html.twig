{% extends 'base.html.twig' %}

{% block title %}Workshop AI – Chat{% endblock %}

{% block body %}
<main class="chat">
    <header class="chat__header">
        <h1>Workshop AI</h1>
    </header>

    {% for message in app.flashes('error') %}
        <p class="flash flash--error">{{ message }}</p>
    {% endfor %}

    <section class="chat__messages" aria-live="polite">
        {% if question is defined %}
            <article class="message message--user">
                <p class="message__text">{{ question|nl2br }}</p>
            </article>
        {% endif %}
        {% if reply is defined and reply %}
            <article class="message message--assistant">
                <p class="message__text">{{ reply.text|nl2br }}</p>
                <footer class="message__meta">
                    {{ reply.model }}
                    · in: {{ reply.inputTokens }} tokens
                    · uit: {{ reply.outputTokens }} tokens
                    {% if reply.stopReason != 'end_turn' %}
                        · stop: {{ reply.stopReason }}
                    {% endif %}
                </footer>
            </article>
        {% endif %}
        {% if question is not defined %}
            <p class="chat__empty">Stel een vraag. Laag 1 heeft geen geheugen: elke vraag staat op zichzelf.</p>
        {% endif %}
    </section>

    {# data-turbo=false: de POST rendert gewoon een pagina, Turbo verwacht anders een redirect #}
    {{ form_start(form, {attr: {class: 'chat__form', 'data-turbo': 'false'}}) }}
        {{ form_row(form.message) }}
        <button type="submit" class="button">Verstuur</button>
    {{ form_end(form) }}
</main>
{% endblock %}
